{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "nginx-wp-lint",
          "version": "0.1.0",
          "semanticVersion": "0.1.0",
          "informationUri": "https://github.com/saizul/nginx-wp-lint",
          "rules": [
            {
              "id": "NWL000",
              "name": "parse-error",
              "shortDescription": {
                "text": "The file could not be read or parsed"
              },
              "fullDescription": {
                "text": "The file could not be read or parsed"
              },
              "help": {
                "text": "Fix the syntax error; `nginx -t` shows the same problem.",
                "markdown": "Fix the syntax error; `nginx -t` shows the same problem."
              },
              "helpUri": "https://github.com/saizul/nginx-wp-lint#rule-reference",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "nginx",
                  "syntax"
                ],
                "precision": "high",
                "problem.severity": "error",
                "security-severity": "8.0"
              }
            },
            {
              "id": "NWL001",
              "name": "server-tokens",
              "shortDescription": {
                "text": "server_tokens is not off, so every response and error page shows the nginx version"
              },
              "fullDescription": {
                "text": "server_tokens is not off, so every response and error page shows the nginx version"
              },
              "help": {
                "text": "Add `server_tokens off;` to the http block.",
                "markdown": "Add `server_tokens off;` to the http block."
              },
              "helpUri": "https://github.com/saizul/nginx-wp-lint#rule-reference",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "nginx",
                  "security",
                  "security"
                ],
                "precision": "high",
                "problem.severity": "recommendation",
                "security-severity": "3.0"
              }
            },
            {
              "id": "NWL002",
              "name": "autoindex-on",
              "shortDescription": {
                "text": "Directory listings are enabled"
              },
              "fullDescription": {
                "text": "Directory listings are enabled"
              },
              "help": {
                "text": "Remove `autoindex on;` (the default is off), or limit it to a dedicated location.",
                "markdown": "Remove `autoindex on;` (the default is off), or limit it to a dedicated location."
              },
              "helpUri": "https://github.com/saizul/nginx-wp-lint#rule-reference",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "nginx",
                  "security",
                  "security"
                ],
                "precision": "high",
                "problem.severity": "warning",
                "security-severity": "5.5"
              }
            },
            {
              "id": "NWL003",
              "name": "dotfiles-exposed",
              "shortDescription": {
                "text": "Hidden files such as .git/, .env and .htaccess can be downloaded"
              },
              "fullDescription": {
                "text": "Hidden files such as .git/, .env and .htaccess can be downloaded"
              },
              "help": {
                "text": "Deny hidden files but keep ACME challenges working: `location ~ /\\.(?!well-known/) { deny all; }`",
                "markdown": "Deny hidden files but keep ACME challenges working: `location ~ /\\.(?!well-known/) { deny all; }`"
              },
              "helpUri": "https://github.com/saizul/nginx-wp-lint#rule-reference",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "nginx",
                  "security",
                  "security"
                ],
                "precision": "high",
                "problem.severity": "error",
                "security-severity": "8.0"
              }
            },
            {
              "id": "NWL004",
              "name": "sensitive-files-exposed",
              "shortDescription": {
                "text": "Backups, database dumps, wp-config.php copies and log files are served if they exist"
              },
              "fullDescription": {
                "text": "Backups, database dumps, wp-config.php copies and log files are served if they exist"
              },
              "help": {
                "text": "Deny them, for example: `location ~* \\.(sql|sql\\.gz|bak|old|orig|save|swp|zip|tar|tar\\.gz|tgz|gz|wpress|log)$|~$ { deny all; }` and `location ~* ^/wp-content/(ai1wm-backups|updraft|backups-dup-lite|uploads/wc-logs)/ { deny all; }`",
                "markdown": "Deny them, for example: `location ~* \\.(sql|sql\\.gz|bak|old|orig|save|swp|zip|tar|tar\\.gz|tgz|gz|wpress|log)$|~$ { deny all; }` and `location ~* ^/wp-content/(ai1wm-backups|updraft|backups-dup-lite|uploads/wc-logs)/ { deny all; }`"
              },
              "helpUri": "https://github.com/saizul/nginx-wp-lint#rule-reference",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "nginx",
                  "security",
                  "security"
                ],
                "precision": "high",
                "problem.severity": "error",
                "security-severity": "8.0"
              }
            },
            {
              "id": "NWL005",
              "name": "wp-config-not-denied",
              "shortDescription": {
                "text": "Requests for wp-config.php reach PHP"
              },
              "fullDescription": {
                "text": "Requests for wp-config.php reach PHP"
              },
              "help": {
                "text": "Add `location = /wp-config.php { deny all; }` as defence in depth.",
                "markdown": "Add `location = /wp-config.php { deny all; }` as defence in depth."
              },
              "helpUri": "https://github.com/saizul/nginx-wp-lint#rule-reference",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "nginx",
                  "security",
                  "security"
                ],
                "precision": "high",
                "problem.severity": "recommendation",
                "security-severity": "3.0"
              }
            },
            {
              "id": "NWL006",
              "name": "xmlrpc-not-blocked",
              "shortDescription": {
                "text": "xmlrpc.php is reachable (brute force amplification and pingback abuse)"
              },
              "fullDescription": {
                "text": "xmlrpc.php is reachable (brute force amplification and pingback abuse)"
              },
              "help": {
                "text": "Block it: `location = /xmlrpc.php { deny all; access_log off; log_not_found off; }`. Jetpack and some apps need it: allow their addresses before `deny all`.",
                "markdown": "Block it: `location = /xmlrpc.php { deny all; access_log off; log_not_found off; }`. Jetpack and some apps need it: allow their addresses before `deny all`."
              },
              "helpUri": "https://github.com/saizul/nginx-wp-lint#rule-reference",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "nginx",
                  "wordpress",
                  "security"
                ],
                "precision": "high",
                "problem.severity": "warning",
                "security-severity": "5.5"
              }
            },
            {
              "id": "NWL007",
              "name": "php-in-uploads",
              "shortDescription": {
                "text": "PHP files inside wp-content/uploads are executed"
              },
              "fullDescription": {
                "text": "PHP files inside wp-content/uploads are executed"
              },
              "help": {
                "text": "Deny PHP in uploads with a regex location placed BEFORE the PHP location: `location ~* ^/wp-content/uploads/.*\\.(php|phtml|phar)$ { deny all; }`. A prefix `location /wp-content/uploads/` does not stop the regex PHP location unless it uses `^~`.",
                "markdown": "Deny PHP in uploads with a regex location placed BEFORE the PHP location: `location ~* ^/wp-content/uploads/.*\\.(php|phtml|phar)$ { deny all; }`. A prefix `location /wp-content/uploads/` does not stop the regex PHP location unless it uses `^~`."
              },
              "helpUri": "https://github.com/saizul/nginx-wp-lint#rule-reference",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "nginx",
                  "wordpress",
                  "security"
                ],
                "precision": "high",
                "problem.severity": "error",
                "security-severity": "8.0"
              }
            },
            {
              "id": "NWL008",
              "name": "php-source-disclosure",
              "shortDescription": {
                "text": "PHP files are served as plain text instead of being executed"
              },
              "fullDescription": {
                "text": "PHP files are served as plain text instead of being executed"
              },
              "help": {
                "text": "Add a PHP location, for example `location ~ \\.php$ { include snippets/fastcgi-php.conf; fastcgi_pass unix:/run/php/php-fpm.sock; }`.",
                "markdown": "Add a PHP location, for example `location ~ \\.php$ { include snippets/fastcgi-php.conf; fastcgi_pass unix:/run/php/php-fpm.sock; }`."
              },
              "helpUri": "https://github.com/saizul/nginx-wp-lint#rule-reference",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "nginx",
                  "wordpress",
                  "security"
                ],
                "precision": "high",
                "problem.severity": "error",
                "security-severity": "8.0"
              }
            },
            {
              "id": "NWL009",
              "name": "acme-challenge-blocked",
              "shortDescription": {
                "text": "A dotfile rule also blocks /.well-known/acme-challenge/ (certificate renewal)"
              },
              "fullDescription": {
                "text": "A dotfile rule also blocks /.well-known/acme-challenge/ (certificate renewal)"
              },
              "help": {
                "text": "Exclude .well-known from the dotfile rule: `location ~ /\\.(?!well-known/) { deny all; }`",
                "markdown": "Exclude .well-known from the dotfile rule: `location ~ /\\.(?!well-known/) { deny all; }`"
              },
              "helpUri": "https://github.com/saizul/nginx-wp-lint#rule-reference",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "nginx",
                  "security",
                  "security"
                ],
                "precision": "high",
                "problem.severity": "recommendation",
                "security-severity": "3.0"
              }
            },
            {
              "id": "NWL010",
              "name": "hsts-missing",
              "shortDescription": {
                "text": "HTTPS server without Strict-Transport-Security"
              },
              "fullDescription": {
                "text": "HTTPS server without Strict-Transport-Security"
              },
              "help": {
                "text": "Add `add_header Strict-Transport-Security \"max-age=31536000; includeSubDomains\" always;` once HTTPS works for every subdomain.",
                "markdown": "Add `add_header Strict-Transport-Security \"max-age=31536000; includeSubDomains\" always;` once HTTPS works for every subdomain."
              },
              "helpUri": "https://github.com/saizul/nginx-wp-lint#rule-reference",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "nginx",
                  "headers",
                  "security"
                ],
                "precision": "high",
                "problem.severity": "warning",
                "security-severity": "5.5"
              }
            },
            {
              "id": "NWL011",
              "name": "hsts-weak",
              "shortDescription": {
                "text": "Strict-Transport-Security max-age is shorter than recommended"
              },
              "fullDescription": {
                "text": "Strict-Transport-Security max-age is shorter than recommended"
              },
              "help": {
                "text": "Use a max-age of at least 15552000 (180 days); 31536000 (one year) is common.",
                "markdown": "Use a max-age of at least 15552000 (180 days); 31536000 (one year) is common."
              },
              "helpUri": "https://github.com/saizul/nginx-wp-lint#rule-reference",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "nginx",
                  "headers",
                  "security"
                ],
                "precision": "high",
                "problem.severity": "recommendation",
                "security-severity": "3.0"
              }
            },
            {
              "id": "NWL012",
              "name": "x-content-type-options-missing",
              "shortDescription": {
                "text": "X-Content-Type-Options: nosniff is not set"
              },
              "fullDescription": {
                "text": "X-Content-Type-Options: nosniff is not set"
              },
              "help": {
                "text": "Add `add_header X-Content-Type-Options nosniff always;`",
                "markdown": "Add `add_header X-Content-Type-Options nosniff always;`"
              },
              "helpUri": "https://github.com/saizul/nginx-wp-lint#rule-reference",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "nginx",
                  "headers",
                  "security"
                ],
                "precision": "high",
                "problem.severity": "recommendation",
                "security-severity": "3.0"
              }
            },
            {
              "id": "NWL013",
              "name": "referrer-policy-missing",
              "shortDescription": {
                "text": "Referrer-Policy is not set"
              },
              "fullDescription": {
                "text": "Referrer-Policy is not set"
              },
              "help": {
                "text": "Add `add_header Referrer-Policy \"strict-origin-when-cross-origin\" always;`",
                "markdown": "Add `add_header Referrer-Policy \"strict-origin-when-cross-origin\" always;`"
              },
              "helpUri": "https://github.com/saizul/nginx-wp-lint#rule-reference",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "nginx",
                  "headers",
                  "security"
                ],
                "precision": "high",
                "problem.severity": "recommendation",
                "security-severity": "3.0"
              }
            },
            {
              "id": "NWL014",
              "name": "csp-missing",
              "shortDescription": {
                "text": "No Content-Security-Policy (or Report-Only) header"
              },
              "fullDescription": {
                "text": "No Content-Security-Policy (or Report-Only) header"
              },
              "help": {
                "text": "Start with a report-only policy and tighten it: `add_header Content-Security-Policy-Report-Only \"default-src 'self'; ...\" always;` WordPress plugins often need inline scripts, so test before enforcing.",
                "markdown": "Start with a report-only policy and tighten it: `add_header Content-Security-Policy-Report-Only \"default-src 'self'; ...\" always;` WordPress plugins often need inline scripts, so test before enforcing."
              },
              "helpUri": "https://github.com/saizul/nginx-wp-lint#rule-reference",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "nginx",
                  "headers",
                  "security"
                ],
                "precision": "high",
                "problem.severity": "recommendation",
                "security-severity": "1.0"
              }
            },
            {
              "id": "NWL015",
              "name": "add-header-inheritance",
              "shortDescription": {
                "text": "A location with its own add_header loses the security headers set at the server or http level"
              },
              "fullDescription": {
                "text": "A location with its own add_header loses the security headers set at the server or http level"
              },
              "help": {
                "text": "Repeat the security headers in this location (an include file helps), use `add_header_inherit merge;` on nginx 1.29.3+, or move the extra header elsewhere.",
                "markdown": "Repeat the security headers in this location (an include file helps), use `add_header_inherit merge;` on nginx 1.29.3+, or move the extra header elsewhere."
              },
              "helpUri": "https://github.com/saizul/nginx-wp-lint#rule-reference",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "nginx",
                  "headers",
                  "security"
                ],
                "precision": "high",
                "problem.severity": "warning",
                "security-severity": "5.5"
              }
            },
            {
              "id": "NWL016",
              "name": "clickjacking-protection-missing",
              "shortDescription": {
                "text": "Neither X-Frame-Options nor a CSP frame-ancestors directive is set"
              },
              "fullDescription": {
                "text": "Neither X-Frame-Options nor a CSP frame-ancestors directive is set"
              },
              "help": {
                "text": "Add `add_header X-Frame-Options \"SAMEORIGIN\" always;` or `frame-ancestors 'self'` in the Content-Security-Policy.",
                "markdown": "Add `add_header X-Frame-Options \"SAMEORIGIN\" always;` or `frame-ancestors 'self'` in the Content-Security-Policy."
              },
              "helpUri": "https://github.com/saizul/nginx-wp-lint#rule-reference",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "nginx",
                  "headers",
                  "security"
                ],
                "precision": "high",
                "problem.severity": "recommendation",
                "security-severity": "3.0"
              }
            },
            {
              "id": "NWL017",
              "name": "header-without-always",
              "shortDescription": {
                "text": "Security headers without `always` are missing from error responses"
              },
              "fullDescription": {
                "text": "Security headers without `always` are missing from error responses"
              },
              "help": {
                "text": "Append `always` to security add_header directives.",
                "markdown": "Append `always` to security add_header directives."
              },
              "helpUri": "https://github.com/saizul/nginx-wp-lint#rule-reference",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "nginx",
                  "headers",
                  "security"
                ],
                "precision": "high",
                "problem.severity": "recommendation",
                "security-severity": "1.0"
              }
            },
            {
              "id": "NWL020",
              "name": "gzip-disabled",
              "shortDescription": {
                "text": "Neither gzip nor brotli compression is enabled"
              },
              "fullDescription": {
                "text": "Neither gzip nor brotli compression is enabled"
              },
              "help": {
                "text": "Add `gzip on;` with `gzip_types` (and `brotli on;` if the module is installed).",
                "markdown": "Add `gzip on;` with `gzip_types` (and `brotli on;` if the module is installed)."
              },
              "helpUri": "https://github.com/saizul/nginx-wp-lint#rule-reference",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "nginx",
                  "performance"
                ],
                "precision": "high",
                "problem.severity": "recommendation",
                "security-severity": "3.0"
              }
            },
            {
              "id": "NWL021",
              "name": "gzip-types-default",
              "shortDescription": {
                "text": "gzip is on but gzip_types is not set, so only text/html is compressed"
              },
              "fullDescription": {
                "text": "gzip is on but gzip_types is not set, so only text/html is compressed"
              },
              "help": {
                "text": "Add `gzip_types text/css application/javascript application/json image/svg+xml text/plain text/xml application/xml;`",
                "markdown": "Add `gzip_types text/css application/javascript application/json image/svg+xml text/plain text/xml application/xml;`"
              },
              "helpUri": "https://github.com/saizul/nginx-wp-lint#rule-reference",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "nginx",
                  "performance"
                ],
                "precision": "high",
                "problem.severity": "recommendation",
                "security-severity": "3.0"
              }
            },
            {
              "id": "NWL022",
              "name": "client-max-body-size",
              "shortDescription": {
                "text": "client_max_body_size is missing (1 MB default), too small, or unlimited"
              },
              "fullDescription": {
                "text": "client_max_body_size is missing (1 MB default), too small, or unlimited"
              },
              "help": {
                "text": "Set `client_max_body_size 64m;` (match upload_max_filesize in php.ini).",
                "markdown": "Set `client_max_body_size 64m;` (match upload_max_filesize in php.ini)."
              },
              "helpUri": "https://github.com/saizul/nginx-wp-lint#rule-reference",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "nginx",
                  "wordpress",
                  "security"
                ],
                "precision": "high",
                "problem.severity": "recommendation",
                "security-severity": "3.0"
              }
            },
            {
              "id": "NWL023",
              "name": "static-assets-no-cache",
              "shortDescription": {
                "text": "CSS, JavaScript and images are served without a cache lifetime (expires or Cache-Control)"
              },
              "fullDescription": {
                "text": "CSS, JavaScript and images are served without a cache lifetime (expires or Cache-Control)"
              },
              "help": {
                "text": "Add a static files location, e.g. `location ~* \\.(?:css|js|mjs|jpe?g|png|gif|webp|avif|svg|ico|woff2?)$ { expires 30d; access_log off; try_files $uri =404; }`",
                "markdown": "Add a static files location, e.g. `location ~* \\.(?:css|js|mjs|jpe?g|png|gif|webp|avif|svg|ico|woff2?)$ { expires 30d; access_log off; try_files $uri =404; }`"
              },
              "helpUri": "https://github.com/saizul/nginx-wp-lint#rule-reference",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "nginx",
                  "performance"
                ],
                "precision": "high",
                "problem.severity": "recommendation",
                "security-severity": "3.0"
              }
            },
            {
              "id": "NWL030",
              "name": "fastcgi-cache-zone-undefined",
              "shortDescription": {
                "text": "fastcgi_cache names a zone that no fastcgi_cache_path defines"
              },
              "fullDescription": {
                "text": "fastcgi_cache names a zone that no fastcgi_cache_path defines"
              },
              "help": {
                "text": "Define it in the http block: `fastcgi_cache_path /var/cache/nginx/wp levels=1:2 keys_zone=WORDPRESS:100m inactive=60m;`",
                "markdown": "Define it in the http block: `fastcgi_cache_path /var/cache/nginx/wp levels=1:2 keys_zone=WORDPRESS:100m inactive=60m;`"
              },
              "helpUri": "https://github.com/saizul/nginx-wp-lint#rule-reference",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "nginx",
                  "cache"
                ],
                "precision": "high",
                "problem.severity": "error",
                "security-severity": "8.0"
              }
            },
            {
              "id": "NWL031",
              "name": "fastcgi-cache-key-missing",
              "shortDescription": {
                "text": "fastcgi_cache is used without fastcgi_cache_key"
              },
              "fullDescription": {
                "text": "fastcgi_cache is used without fastcgi_cache_key"
              },
              "help": {
                "text": "Add `fastcgi_cache_key \"$scheme$request_method$host$request_uri\";`",
                "markdown": "Add `fastcgi_cache_key \"$scheme$request_method$host$request_uri\";`"
              },
              "helpUri": "https://github.com/saizul/nginx-wp-lint#rule-reference",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "nginx",
                  "cache"
                ],
                "precision": "high",
                "problem.severity": "error",
                "security-severity": "8.0"
              }
            },
            {
              "id": "NWL032",
              "name": "fastcgi-cache-no-bypass",
              "shortDescription": {
                "text": "FastCGI cache without a bypass for logged-in users, carts and POST requests: private pages can be cached and shown to visitors"
              },
              "fullDescription": {
                "text": "FastCGI cache without a bypass for logged-in users, carts and POST requests: private pages can be cached and shown to visitors"
              },
              "help": {
                "text": "Skip the cache for logged-in users and carts, for example: `set $skip_cache 0; if ($http_cookie ~* \"comment_author|wordpress_[a-f0-9]+|wp-postpass|wordpress_no_cache|wordpress_logged_in|woocommerce_items_in_cart\") { set $skip_cache 1; } fastcgi_cache_bypass $skip_cache; fastcgi_no_cache $skip_cache;`",
                "markdown": "Skip the cache for logged-in users and carts, for example: `set $skip_cache 0; if ($http_cookie ~* \"comment_author|wordpress_[a-f0-9]+|wp-postpass|wordpress_no_cache|wordpress_logged_in|woocommerce_items_in_cart\") { set $skip_cache 1; } fastcgi_cache_bypass $skip_cache; fastcgi_no_cache $skip_cache;`"
              },
              "helpUri": "https://github.com/saizul/nginx-wp-lint#rule-reference",
              "defaultConfiguration": {
